# Required: generate a long random secret for JARVIS backend access
JARVIS_TOKEN=replace-with-a-long-random-secret
CORS_ORIGINS=https://saurabh-18-stalk.github.io
DATABASE_PATH=jarvis.db

# Choose ONE active provider: openrouter, groq, or gemini
AI_PROVIDER=openrouter
# Optional model override. Defaults: openrouter/free, openai/gpt-oss-20b, gemini-2.5-flash
AI_MODEL=

# Add your own key for the selected provider on your backend host.
# Never commit real keys or enter provider keys in the public JARVIS website.
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

PUBLIC_APP_URL=https://saurabh-18-stalk.github.io/Jarvis--PWA/
